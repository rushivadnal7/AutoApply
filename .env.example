# ── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Database (packages/db, apps/api, apps/worker) ──────────────────────────
# Local dev (docker compose): postgresql://postgres:postgres@localhost:5432/jobapp
# Supabase (prod free tier): use the "Connection pooling" URI for DATABASE_URL
# and the "Direct connection" URI for DIRECT_URL (Prisma needs both).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobapp"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/jobapp"

# ── Supabase Storage (resumes) ──────────────────────────────────────────────
# Leave blank in local dev to fall back to local-disk storage (apps/api/uploads).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# ── Redis / BullMQ (apps/api, apps/worker) ──────────────────────────────────
# Local dev (docker compose): redis://localhost:6379
# Upstash (prod free tier): rediss://default:<password>@<host>:6379
REDIS_URL="redis://localhost:6379"

# ── Auth (apps/api) ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Credential encryption (apps/api, apps/worker) ────────────────────────────
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ── apps/api ──────────────────────────────────────────────────────────────
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# ── apps/worker ───────────────────────────────────────────────────────────
WORKER_HEALTH_PORT=4100
WORKER_HEADLESS=true
# Default pacing delay between applications, in seconds
WORKER_DEFAULT_PACING_SECONDS=20

# ── apps/web ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Error tracking (optional, Phase 12) ─────────────────────────────────────
SENTRY_DSN=
