{
  "name": "job-application-dashboard",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @job-app/db generate",
    "db:migrate": "pnpm --filter @job-app/db migrate:dev",
    "db:seed": "pnpm --filter @job-app/db seed",
    "db:seed:demo": "pnpm --filter @job-app/db seed:demo",
    "db:studio": "pnpm --filter @job-app/db studio",
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.9"
}
